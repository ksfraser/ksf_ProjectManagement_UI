{
    "name": "ksfraser/ksf-project-management-ui",
    "description": "Standalone Project Management UI - frontend for ksf-project-management. Works with or without FrontAccounting.",
    "type": "library",
    "license": "GPL-3.0",
    "keywords": [
        "project-management",
        "ui",
        "frontend",
        "gantt",
        "dotproject",
        "frontaccounting",
        "ksf"
    ],
    "authors": [
        {
            "name": "KSFII Development Team",
            "email": "dev@ksfii.org"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "ksfraser/ksf-project-management": "^1.0",
        "ksfraser/html": "^1.0",
        "ksfraser/superglobals": "^1.0",
        "doctrine/dbal": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpdocumentor/phpdocumentor": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\PMUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\PMUI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "phpdoc": "phpdocumentor",
        "phpstan": "phpstan analyse src --level=8"
    },
    "config": {
        "sort-packages": true
    }
}